# Example OAuth Configuration
# Copy relevant sections to your .env file

# ============================================================
# OAuth Global Settings
# ============================================================
OAUTH_ENABLED=true
OAUTH_AUTO_CREATE_USER=true
OAUTH_AUTO_LINK_BY_EMAIL=false
OAUTH_DEFAULT_ROLE=viewer

# Generate encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=your_32_byte_fernet_key_here

# ============================================================
# Google OAuth
# ============================================================
# Get credentials from: https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:5000/oauth/callback/google
OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================
# GitHub OAuth
# ============================================================
# Get credentials from: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/oauth/callback/github
OAUTH_GITHUB_ENABLED=true
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================================
# Generic OIDC (Keycloak, Auth0, Okta, Azure AD, etc.)
# ============================================================
OAUTH_OIDC_ENABLED=false
OAUTH_OIDC_CLIENT_ID=your_oidc_client_id
OAUTH_OIDC_CLIENT_SECRET=your_oidc_client_secret
OAUTH_OIDC_DISCOVERY_URL=https://your-idp.com/.well-known/openid-configuration
OAUTH_OIDC_PROVIDER_NAME="OIDC"

# ============================================================
# Example: Keycloak
# ============================================================
# OAUTH_OIDC_DISCOVERY_URL=https://keycloak.example.com/auth/realms/master/.well-known/openid-configuration
# OAUTH_OIDC_PROVIDER_NAME="Keycloak"

# ============================================================
# Example: Auth0
# ============================================================
# OAUTH_OIDC_DISCOVERY_URL=https://your-tenant.auth0.com/.well-known/openid-configuration
# OAUTH_OIDC_PROVIDER_NAME="Auth0"

# ============================================================
# Example: Azure AD
# ============================================================
# OAUTH_OIDC_DISCOVERY_URL=https://login.microsoftonline.com/{tenant}/v2.0/.well-known/openid-configuration
# OAUTH_OIDC_PROVIDER_NAME="Microsoft"
