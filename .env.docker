# ELASLIP Configuration for Docker
# Copy this file to .env and configure your settings

# ============================================================
# Flask Server Configuration
# ============================================================
FLASK_ENV=development
FLASK_APP=app
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
APP_URL=http://localhost:5000

# ============================================================
# Site Branding
# ============================================================
SITE_NAME=ELASLIP
SITE_TITLE=ELASLIP

# ============================================================
# Elasticsearch (Auto-configured for Docker Compose)
# ============================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic123
ELASTICSEARCH_MEMORY_XMS=256m
ELASTICSEARCH_MEMORY_XMX=256m

# ============================================================
# Redis (Auto-configured for Docker Compose)
# ============================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ============================================================
# Default Admin Account
# ============================================================
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ============================================================
# Demo Data
# ============================================================
DEMO_DATA_ENABLED=false

# ============================================================
# LLM Configuration (Optional)
# ============================================================
LLM_ENABLED=false
LLM_PROVIDER=auto
LLM_URL=http://ollama:11434
LLM_MODEL=mistral
LLM_API_KEY=
LLM_GENERATION_LANGUAGE=en

# ============================================================
# Public Access
# ============================================================
PUBLIC_SEARCH_ENABLED=true
PUBLIC_SUBMISSIONS_SUBMIT_ENABLED=true
PUBLIC_SUBMISSIONS_MAX_RESULTS=10
PUBLIC_SUBMISSIONS_ALLOW_ANONYMOUS=true

# ============================================================
# OAuth Configuration
# ============================================================

# Enable OAuth authentication
OAUTH_ENABLED=false

# Auto-create user accounts on first OAuth login
OAUTH_AUTO_CREATE_USER=true

# Auto-link OAuth accounts to existing users by email (security risk - use with caution)
OAUTH_AUTO_LINK_BY_EMAIL=false

# Default role for new OAuth users (viewer, analyst, admin)
OAUTH_DEFAULT_ROLE=viewer

# Generate this key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED if OAuth is enabled
OAUTH_ENCRYPTION_KEY=

# ============================================================
# Google OAuth
# ============================================================
# To enable Google OAuth:
# 1. Go to https://console.cloud.google.com/
# 2. Create OAuth 2.0 Client ID
# 3. Add redirect URI: http://localhost:5000/oauth/callback/google
# 4. Copy Client ID and Secret below
# 5. Set OAUTH_GOOGLE_ENABLED=true

OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ============================================================
# GitHub OAuth
# ============================================================
# To enable GitHub OAuth:
# 1. Go to https://github.com/settings/developers
# 2. Create new OAuth App
# 3. Set callback URL: http://localhost:5000/oauth/callback/github
# 4. Copy Client ID and Secret below
# 5. Set OAUTH_GITHUB_ENABLED=true

OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ============================================================
# Generic OIDC (Keycloak, Auth0, Okta, Azure AD, etc.)
# ============================================================
# To enable OIDC:
# 1. Configure client in your OIDC provider
# 2. Set redirect URI: http://localhost:5000/oauth/callback/oidc
# 3. Get discovery URL (usually ends with /.well-known/openid-configuration)
# 4. Copy credentials below
# 5. Set OAUTH_OIDC_ENABLED=true

OAUTH_OIDC_ENABLED=false
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_DISCOVERY_URL=
OAUTH_OIDC_PROVIDER_NAME=OIDC

# ============================================================
# Examples for specific OIDC providers
# ============================================================

# Keycloak Example:
# OAUTH_OIDC_DISCOVERY_URL=https://keycloak.example.com/auth/realms/master/.well-known/openid-configuration
# OAUTH_OIDC_PROVIDER_NAME=Keycloak

# Auth0 Example:
# OAUTH_OIDC_DISCOVERY_URL=https://your-tenant.auth0.com/.well-known/openid-configuration
# OAUTH_OIDC_PROVIDER_NAME=Auth0

# Azure AD Example:
# OAUTH_OIDC_DISCOVERY_URL=https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid-configuration
# OAUTH_OIDC_PROVIDER_NAME=Microsoft

# ============================================================
# Production Settings (Uncomment for production)
# ============================================================
# FLASK_ENV=production
# SECRET_KEY=<generate-a-long-random-key>
# APP_URL=https://your-domain.com
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_SAMESITE=Strict
# DEMO_DATA_ENABLED=false
